#!/bin/bash
set -e

# ─────────────────────────────────────────────────────────────────────────────
# cluster — stand up the KinD cluster + the Nova monitoring platform (dashboard).
#
# "Cluster up" now gives you the basic infra ready to observe anything:
#   • the KinD cluster itself
#   • the Nova monitoring platform (metrics-server, Loki, Fluent Bit, Prometheus,
#     Grafana, and the Nova dashboard) — deployed by ./scripts/platform
#
# Then deploy workloads with:
#
#     examples/kind-demo/scripts/deploy-reference-apps.sh
#
# (OpenTelemetry Demo / Online Boutique / Sock Shop / Prometheus example /
# Custom Payment System).
# ─────────────────────────────────────────────────────────────────────────────

# ── Colors ────────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log()     { echo -e "${CYAN}[CLUSTER]${NC} $1"; }
success() { echo -e "${GREEN}[OK]${NC} $1"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
error()   { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

CLUSTER_NAME="nova-platform"

# Host folder bind-mounted into every KinD node (extraMounts) and later
# hostPath-mounted into the dashboard pod at /data to persist the incident store
# across teardown/setup. Created here so the mount target exists at cluster time.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
DATA_DIR="${PROJECT_ROOT}/data"

cd "$PROJECT_ROOT"

echo ""
echo -e "${CYAN}╔════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║   KinD Cluster Setup (cluster only)    ║${NC}"
echo -e "${CYAN}╚════════════════════════════════════════╝${NC}"
echo ""

# ── Prerequisites ─────────────────────────────────────────────────────────────
log "Checking prerequisites..."
command -v docker >/dev/null 2>&1 || error "Docker not found. Install Docker Desktop."
command -v kind >/dev/null 2>&1   || error "KinD not found. Run: brew install kind"
command -v kubectl >/dev/null 2>&1 || error "kubectl not found. Run: brew install kubectl"

# Unset platform override — KinD node runs as amd64 under Rosetta on M1
unset DOCKER_DEFAULT_PLATFORM
success "All prerequisites found"

# ── Create KinD cluster ───────────────────────────────────────────────────────
log "Creating KinD cluster: ${CLUSTER_NAME}..."

if kind get clusters 2>/dev/null | grep -q "^${CLUSTER_NAME}$"; then
  warn "Cluster '${CLUSTER_NAME}' already exists — skipping creation"
else
  # World-writable so the non-root dashboard container (uid 1001) can write the
  # incident store once it is deployed later.
  mkdir -p "${DATA_DIR}"
  chmod 777 "${DATA_DIR}"
  log "Persistent incident store: ${DATA_DIR} (mounted into nodes at /mnt/dashboard-data)"

  cat <<EOF | kind create cluster --name "${CLUSTER_NAME}" --config=-
kind: Cluster
apiVersion: kind.x-k8s.io/v1alpha4
nodes:
  - role: control-plane
    image: kindest/node:v1.29.2
    kubeadmConfigPatches:
      - |
        kind: InitConfiguration
        nodeRegistration:
          kubeletExtraArgs:
            node-labels: "ingress-ready=true"
    extraPortMappings:
      - containerPort: 30000
        hostPort: 3000
        protocol: TCP
    extraMounts:
      - hostPath: ${DATA_DIR}
        containerPath: /mnt/dashboard-data
  - role: worker
    image: kindest/node:v1.29.2
    extraMounts:
      - hostPath: ${DATA_DIR}
        containerPath: /mnt/dashboard-data
  - role: worker
    image: kindest/node:v1.29.2
    extraMounts:
      - hostPath: ${DATA_DIR}
        containerPath: /mnt/dashboard-data
EOF
  success "KinD cluster created"
fi

# Explicitly set kubectl context — ensures idempotency on re-runs
kind export kubeconfig --name "${CLUSTER_NAME}"
success "kubectl context configured"

# ── Wait for API server ───────────────────────────────────────────────────────
log "Waiting for Kubernetes API server to be ready..."
for i in $(seq 1 30); do
  if kubectl cluster-info >/dev/null 2>&1; then
    success "API server is ready"
    break
  fi
  if [ "$i" -eq 30 ]; then
    error "API server did not become ready in time"
  fi
  sleep 2
done

echo ""
echo -e "${GREEN}╔════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║  Cluster is up — deploying platform…    ║${NC}"
echo -e "${GREEN}╚════════════════════════════════════════╝${NC}"
echo ""

# ── Deploy the Nova monitoring platform (basic infra) ─────────────────────────
# Single source of truth lives in ./platform, so re-running it standalone repairs
# the platform without recreating the cluster.
bash "${SCRIPT_DIR}/platform"
