#!/bin/bash
set -e

# ─────────────────────────────────────────────────────────────────────────────
# platform — deploy Nova (dashboard + Sentinel) onto a running cluster via Helm.
#
# Nova is the product: a single AI dashboard (plus the read-only Sentinel
# early-detection companion) that plugs into whatever observability a workload
# already exposes. It is deployed with the SAME Helm chart used in production
# (deploy/helm/nova) — only the values differ (local images, in-cluster
# backends), so local == prod. The platform ships nothing but Nova itself — no
# Loki, Prometheus, Grafana, Fluent Bit. Each demo workload brings its OWN stack
# (logs, metrics, Grafana, alert rules); you then point Nova at that workload's
# backends (deploy-reference-apps.sh does this automatically for the bundled
# Custom Payment System).
#
# Invoked automatically at the end of `cluster`; re-runnable to repair/redeploy.
# ─────────────────────────────────────────────────────────────────────────────

# ── Colors ────────────────────────────────────────────────────────────────────
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

log()     { echo -e "${CYAN}[PLATFORM]${NC} $1"; }
success() { echo -e "${GREEN}[OK]${NC} $1"; }
warn()    { echo -e "${YELLOW}[WARN]${NC} $1"; }
error()   { echo -e "${RED}[ERROR]${NC} $1"; exit 1; }

# Run from the project root so relative k8s/... and Dockerfile paths resolve.
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PROJECT_ROOT="$(cd "$SCRIPT_DIR/../../.." && pwd)"
cd "$PROJECT_ROOT"

CLUSTER_NAME="nova-platform"
MON_NAMESPACE="nova-monitoring"
K8S="examples/kind-demo/k8s"

# metrics-server is installed so Nova's in-process metrics reader can show
# CPU/mem/pod-health for ANY workload with zero config. (For clusters that
# already run Prometheus, point Nova at it with metrics.provider: prometheus.)

# ── Prerequisites ─────────────────────────────────────────────────────────────
command -v kubectl >/dev/null 2>&1 || error "kubectl not found. Run: brew install kubectl"
command -v docker >/dev/null 2>&1  || error "Docker not found. Install Docker Desktop."
command -v helm >/dev/null 2>&1    || error "helm not found. Run: brew install helm"
kubectl cluster-info >/dev/null 2>&1 || error "No reachable cluster. Run ./examples/kind-demo/scripts/cluster first."

echo ""
echo -e "${CYAN}╔══════════════════════════════════════════════╗${NC}"
echo -e "${CYAN}║   Nova dashboard (the product)                ║${NC}"
echo -e "${CYAN}╚══════════════════════════════════════════════╝${NC}"
echo ""
log "Deploying Nova (dashboard + Sentinel) → namespace '${MON_NAMESPACE}'..."

kubectl get namespace "$MON_NAMESPACE" >/dev/null 2>&1 || kubectl create namespace "$MON_NAMESPACE"

# AI keys secret (dashboard reads these; optional if you have no keys yet).
if [ -f "$K8S/secret.yaml" ]; then
  kubectl apply -f "$K8S/secret.yaml"
  success "AI keys secret applied from $K8S/secret.yaml"
else
  warn "No $K8S/secret.yaml — creating an empty ai-keys secret"
  warn "  cp $K8S/secret.yaml.template $K8S/secret.yaml, add keys, then kubectl apply -f it"
  kubectl create secret generic ai-keys -n "$MON_NAMESPACE" \
    --from-literal=OPENROUTER_API_KEY="" --from-literal=ANTHROPIC_API_KEY="" \
    --dry-run=client -o yaml | kubectl apply -f -
fi

# ── Nova images (built locally, kind-loaded — never pulled) ───────────────────
# build_and_load: build the image if missing, then load it into KinD if absent.
build_and_load() {
  local image="$1" dockerfile="$2" ctx="${3:-.}" short="${1%%:*}"
  if docker image inspect "$image" >/dev/null 2>&1; then
    warn "$image already built — skipping (docker rmi $image to rebuild)"
  else
    log "Building $image..."
    docker build -t "$image" -f "$dockerfile" "$ctx" || error "Build failed: $image"
    success "$image built"
  fi
  if docker exec "${CLUSTER_NAME}-control-plane" crictl images 2>/dev/null | grep -q "$short"; then
    warn "$image already in cluster — skipping load"
  else
    log "Loading $image into KinD..."
    kind load docker-image "$image" --name "$CLUSTER_NAME" || error "kind load failed: $image"
    success "$image loaded"
  fi
}

# The Nova dashboard (the product) + the Sentinel companion (read-only early
# detection). Both ship as SEPARATE images — exactly as in production.
build_and_load "nova/dashboard:latest" "Dockerfile"
build_and_load "nova/sentinel:latest"  "deploy/sentinel/Dockerfile"

# ── metrics-server (pod CPU/memory for Nova's native metrics reader) ──────────
# Nova's dashboard reads pod/deployment/namespace health directly from the
# Kubernetes API IN-PROCESS (no external collector); pod CPU/memory come from
# metrics-server. Idempotent: re-applying is a no-op if it's already installed.
log "Installing metrics-server (pod CPU/memory source)..."
kubectl apply -f https://github.com/kubernetes-sigs/metrics-server/releases/latest/download/components.yaml
kubectl patch deployment metrics-server -n kube-system --type=json \
  -p='[{"op":"add","path":"/spec/template/spec/containers/0/args/-","value":"--kubelet-insecure-tls"}]' \
  2>/dev/null || true

# ── Deploy Nova via the SAME Helm chart used in production ─────────────────────
# One chart, one definition — local == prod. The kind values (k8s/nova-values.yaml)
# only swap in local images + in-cluster backends. This creates the dashboard, its
# read-only metrics RBAC, the config ConfigMap, the incident-store PVC, AND the
# Sentinel companion (values sentinel.enabled: true).
log "Installing the Nova Helm chart (dashboard + Sentinel) → '${MON_NAMESPACE}'..."
helm upgrade --install nova deploy/helm/nova \
  -n "$MON_NAMESPACE" -f "$K8S/nova-values.yaml" \
  --wait --timeout 4m || error "Helm install failed"
success "Nova deployed (dashboard + Sentinel companion)"

# ── Serve: the dashboard Service is a NodePort (30000) that KinD maps to the host
# at :3000 (see the cluster's extraPortMappings), so it's reachable directly at
# http://localhost:3000 — no fragile kubectl port-forward to die or collide with
# Colima's own port mapping.
log "Waiting for the dashboard on http://localhost:3000 ..."
# Clean up any stale port-forward from older setups that would squat :3000.
pkill -f "nova-port-forward" 2>/dev/null || true
pkill -f "port-forward .*dashboard 3000:3000" 2>/dev/null || true
for i in $(seq 1 30); do
  curl -sf -o /dev/null "http://localhost:3000/overview" && { success "Dashboard: http://localhost:3000/overview"; break; }
  [ "$i" -eq 30 ] && warn "Dashboard not confirmed on :3000 yet — check: kubectl get svc dashboard -n $MON_NAMESPACE (NodePort 30000 ↔ host 3000)"
  sleep 2
done

# Optional: trusted https://nova (mkcert + Caddy). Nova is the only proxied host.
if command -v mkcert >/dev/null 2>&1 && command -v caddy >/dev/null 2>&1; then
  log "Setting up trusted HTTPS (mkcert + Caddy)..."
  if ! grep -qE "^[^#]*[[:space:]]nova([[:space:]]|$)" /etc/hosts 2>/dev/null; then
    warn "Add a hosts entry to reach https://nova:"
    warn "  sudo sh -c 'echo \"127.0.0.1    nova\" >> /etc/hosts'"
  fi
  mkcert -install >/dev/null 2>&1 || warn "mkcert -install failed — cert may not be trusted"
  mkdir -p "${PROJECT_ROOT}/certs"
  if [ ! -f "${PROJECT_ROOT}/certs/nova.pem" ] || [ ! -f "${PROJECT_ROOT}/certs/nova-key.pem" ]; then
    mkcert -cert-file "${PROJECT_ROOT}/certs/nova.pem" \
           -key-file "${PROJECT_ROOT}/certs/nova-key.pem" nova \
      && success "Cert generated: certs/nova.pem"
  fi
  # Nova-only reverse-proxy config (regenerated if missing — certs/ is gitignored).
  if [ ! -f "${PROJECT_ROOT}/certs/Caddyfile" ]; then
    cat > "${PROJECT_ROOT}/certs/Caddyfile" <<'CADDY'
nova {
	tls certs/nova.pem certs/nova-key.pem
	reverse_proxy localhost:3000
}
CADDY
  fi
  (cd "$PROJECT_ROOT" && sudo caddy start --config certs/Caddyfile 2>/dev/null) \
    && success "Serving https://nova" \
    || warn "Caddy did not start — run: sudo caddy start --config certs/Caddyfile"
fi

echo ""
echo -e "${GREEN}╔══════════════════════════════════════════════╗${NC}"
echo -e "${GREEN}║  Nova dashboard ready — the product is up     ║${NC}"
echo -e "${GREEN}╚══════════════════════════════════════════════╝${NC}"
echo ""
echo "Deploy a workload (each brings its own observability stack):"
echo "  ./examples/kind-demo/scripts/deploy-reference-apps.sh"
echo ""
